{
  "info": {
    "_postman_id": "government-creator-awards-api-v1",
    "name": "Government Creator Awards Portal API",
    "description": "Complete Postman collection for Government Creator Awards Portal backend (Auth, OTP, Categories, Participants, and Dashboard Stats).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    console.log('adminToken saved automatically:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate Admin and automatically store signed JWT token into {{adminToken}} collection variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "OTP Verification",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/otp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "send"
              ]
            },
            "description": "Send 6-digit OTP to mobile number via Fast2SMS (or Dev console mode)."
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "verify"
              ]
            },
            "description": "Verify OTP code for mobile number."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "description": "Public list of award categories."
          },
          "response": []
        },
        {
          "name": "Get Category by Slug (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/tech-ai-innovation-creator",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories",
                "tech-ai-innovation-creator"
              ]
            },
            "description": "Public endpoint to retrieve category by slug."
          },
          "response": []
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "tier",
                  "value": "A_CULTURE_IDENTITY",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Digital Gaming & Esports Creator",
                  "type": "text"
                },
                {
                  "key": "shortDescription",
                  "value": "Celebrating top game developers, streamers, and esports content creators.",
                  "type": "text"
                },
                {
                  "key": "taskBrief",
                  "value": "Submit a video or game demo highlighting positive gaming culture or educational gaming.",
                  "type": "text"
                },
                {
                  "key": "hashtag",
                  "value": "#IndiaGamingAwards",
                  "type": "text"
                },
                {
                  "key": "prizeTier",
                  "value": "FLAGSHIP",
                  "type": "text"
                },
                {
                  "key": "cashPrizeMin",
                  "value": "50000",
                  "type": "text"
                },
                {
                  "key": "cashPrizeMax",
                  "value": "300000",
                  "type": "text"
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Option 1: Upload image file"
                },
                {
                  "key": "imageUrl",
                  "value": "https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&q=80",
                  "type": "text",
                  "description": "Option 2: Direct image URL string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "description": "Create a new category (supports both file upload via 'image' file field OR direct image URL string via 'image'/'imageUrl' body parameter)."
          },
          "response": []
        },
        {
          "name": "Update Category (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "shortDescription",
                  "value": "Updated description for digital gaming & esports award category.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CATEGORY_ID_HERE"
                }
              ]
            },
            "description": "Update category by ID."
          },
          "response": []
        },
        {
          "name": "Delete Category (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CATEGORY_ID_HERE"
                }
              ]
            },
            "description": "Delete category by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Participants",
      "item": [
        {
          "name": "Submit Participant Nomination (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"phone\": \"9876543210\",\n  \"age\": 25,\n  \"district\": \"Mumbai Suburban\",\n  \"platform\": \"YouTube\",\n  \"category\": \"tech-ai-innovation-creator\",\n  \"submissionLink\": \"https://youtube.com/watch?v=example123\",\n  \"instagram\": \"https://instagram.com/rahultech\",\n  \"youtube\": \"https://youtube.com/@rahultech\",\n  \"twitter\": \"https://x.com/rahultech\",\n  \"linkedin\": \"https://linkedin.com/in/rahultech\",\n  \"isInternational\": false,\n  \"privacyAccepted\": true,\n  \"consentAccepted\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/participants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "participants"
              ]
            },
            "description": "Submit nomination form (Requires OTP to be verified for phone number first)."
          },
          "response": []
        },
        {
          "name": "Get Participant Profile (by Phone/Email/ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/participants/profile?phone=9876543210",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "participants",
                "profile"
              ],
              "query": [
                {
                  "key": "phone",
                  "value": "9876543210",
                  "description": "Lookup by mobile number"
                },
                {
                  "key": "email",
                  "value": "rahul.sharma@example.com",
                  "disabled": true,
                  "description": "Lookup by email address"
                },
                {
                  "key": "id",
                  "value": "PARTICIPANT_ID_HERE",
                  "disabled": true,
                  "description": "Lookup by participant ID"
                }
              ]
            },
            "description": "Get complete participant profile by phone, email, or participant ID."
          },
          "response": []
        },
        {
          "name": "Get All Participants (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/participants?status=PENDING&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "participants"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get all participant nominations with optional status filter, search, and pagination."
          },
          "response": []
        },
        {
          "name": "Get Single Participant (Admin)",
          "request": {
            "method": "GET",
