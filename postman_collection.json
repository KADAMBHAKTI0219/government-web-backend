              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/participants/:id/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "participants",
                ":id",
                "status"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "PARTICIPANT_ID_HERE"
                }
              ]
            },
            "description": "Update participant status (PENDING, SUBMITTED, APPROVED, REJECTED)."
          },
          "response": []
        },
        {
          "name": "Delete Participant (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/participants/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "participants",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "PARTICIPANT_ID_HERE"
                }
              ]
            },
            "description": "Delete participant record."
          },
          "response": []
        }
      ]
    },
