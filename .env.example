# Environment Configuration - Chhattisgarh Creator & Influencer Awards Portal Backend

NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cg_awards_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_cg_awards_jwt_key_2026_production_grade
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=super_secret_cg_awards_refresh_jwt_key_2026
JWT_REFRESH_EXPIRE=7d

# Cookie Security
COOKIE_SECRET=super_secret_cookie_signing_key_cg_awards

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Chhattisgarh Creator Awards <no-reply@cgawards.gov.in>

# Frontend URL
FRONTEND_URL=http://localhost:3000

# System Settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4

# reCAPTCHA / CAPTCHA Verification
RECAPTCHA_SECRET_KEY=YOUR_SECRET_KEY
# Set DISABLE_CAPTCHA=true to bypass captcha verification in dev/testing environments
DISABLE_CAPTCHA=false
